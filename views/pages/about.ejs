<%- include('../partials/head', { styles: ['search'] }) %>
  <main class="container text-center margin-from-top main-content">
    <h1>About Drinkly</h1>
    <h3 class="text-muted" style="color:var(--accent-primary)">Convenience at a sip</h3>

    <section class="margin-from-top">
      <h2>Our Mission</h2>
      <div class="info-box" style="color:var(--accent-primary)">
        <p>
          Drinkly is your personal guide to cocktails, homebrewing, and beverage discovery. Whether you're mixing a
          martini or crafting a ginger beer, we help you track, review, and share your drink experiences with friends.
        </p>
      </div>
    </section>

    <section class="margin-from-top">
      <h2>Why We Built This</h2>
      <div class="info-box" style="color:var(--accent-primary)">
        <p>
          We believe that drinks bring people together. With so many amazing recipes and stories out there, we wanted a
          single space to explore, save, and celebrate all things liquid and delicious.
        </p>
      </div>
    </section>

    <section class="margin-from-top">
      <h2>Meet the Team</h2>
      <div class="info-box">
        <p style="color:var(--accent-primary)">
          This website was created by a group of Computer Science students at the University of Adelaide. We're
          developers, designers, and drink enthusiasts who wanted to blend our passions into something
          meaningful. Cheers to community, creativity, and collaboration!
        </p>
      </div>
    </section>
  </main>
<%- include('../partials/foot') %>
