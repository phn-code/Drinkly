<%- include('../partials/head', { styles: ['search', 'list_page'], scripts: ['lists'] }) %>
  <main class="container text-center margin-from-top main-content">
    <h1>Your Lists</h1>
    <div id="listDrinksModal" class="modal-overlay">
      <div class="modal-content">
        <button type="button" class="modal-close-btn" title="Close">&times;</button>
        <h2 id="listDrinksTitle">Drinks in List</h2>
        <div id="drinksInList"></div>
      </div>
    </div>

    <div class="page-wrapper">
      <section class="lists-container">
        <button type="button" id="openCreateListModalBtn" class="create-new-list-button">
          <span class="create-new-list-icon">+</span>
          <span class="create-new-list-text">Create new list</span>
        </button>
        <div id="existingLists" class="existing-lists-grid"></div>
      </section>
    </div>

    <div id="createListModal" class="modal-overlay">
      <div class="modal-content">
        <button type="button" class="modal-close-btn" title="Close">&times;</button>
        <h2>Create List</h2>
        <form id="createListForm" action="/lists/new" method="get">
          <div class="form-group">
            <label for="listName">List name</label>
            <input type="text" id="listName" name="name" maxlength="100" required>
          </div>
          <div class="form-group">
            <label for="listDescription">Description</label>
            <textarea id="listDescription" name="description" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label>Choose an Icon</label>
            <div class="default-image-selector">
<% listIcons.forEach((icon, i) => { %>
              <img src="<%= icon %>" alt="List Icon <%= i + 1 %>" class="default-image-option" data-icon="<%= icon %>">
<% }) %>
            </div>
            <input type="hidden" id="selectedListIcon" name="icon" value="">
          </div>
          <button type="submit" class="modal-submit-btn">Create List</button>
        </form>
      </div>
    </div>
  </main>
<%- include('../partials/foot') %>
